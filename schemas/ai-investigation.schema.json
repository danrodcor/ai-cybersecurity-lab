{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danrodcor/ai-cybersecurity-lab/schemas/ai-investigation.schema.json",
  "title": "AI-Assisted Security Investigation",
  "description": "Versioned contract for evidence-grounded AI investigation output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "confidence",
    "observed_facts",
    "hypotheses",
    "recommended_actions",
    "requires_human_approval"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "confidence": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "recommended_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "requires_human_approval": {
      "type": "boolean",
      "const": true
    }
  }
}
